#!/system/bin/sh
# NetProxy 命令行工具

set -e
set -u

readonly MODDIR="$(cd "$(dirname "$0")/.." && pwd)"
readonly SCRIPTS_DIR="$MODDIR/scripts"
readonly CONFIG_DIR="$MODDIR/config"
readonly MODULE_CONF="$CONFIG_DIR/module.conf"
readonly XRAY_DIR="$CONFIG_DIR/xray"
readonly DEFAULT_XRAY_CONFIG="$XRAY_DIR/config.json"
readonly LOG_DIR="$MODDIR/logs"
readonly SERVICE_LOG="$LOG_DIR/service.log"
readonly XRAY_LOG="$LOG_DIR/xray.log"

readonly XRAY_BIN="$MODDIR/bin/xray"
readonly SERVICE_SCRIPT="$SCRIPTS_DIR/core/service.sh"
readonly GEO_UPDATE_SCRIPT="$SCRIPTS_DIR/core/geo_update.sh"
readonly GEOIP_FILE="$XRAY_DIR/geoip.dat"
readonly GEOSITE_FILE="$XRAY_DIR/geosite.dat"

# 允许通过 cli conf 读写的 module.conf 键（均为 0/1 开关）
readonly CONF_SWITCH_KEYS="AUTO_START PROXY_IPV6 PROXY_HOTSPOT"

. "$MODDIR/scripts/utils/common.sh"
. "$MODDIR/scripts/utils/config.sh"

if [ -t 1 ]; then
  readonly RED="$(printf '\033[0;31m')"
  readonly GREEN="$(printf '\033[0;32m')"
  readonly YELLOW="$(printf '\033[1;33m')"
  readonly BLUE="$(printf '\033[0;34m')"
  readonly NC="$(printf '\033[0m')"
else
  readonly RED=""
  readonly GREEN=""
  readonly YELLOW=""
  readonly BLUE=""
  readonly NC=""
fi

#######################################
# 终端输出
#######################################
info() {
  printf "%s[信息]%s %s\n" "$GREEN" "$NC" "$1"
}

warn() {
  printf "%s[警告]%s %s\n" "$YELLOW" "$NC" "$1"
}

die_cli() {
  printf "%s[错误]%s %s\n" "$RED" "$NC" "$1" >&2
  exit 1
}

section() {
  printf "\n%s%s%s\n" "$BLUE" "$1" "$NC"
}

#######################################
# 基础辅助
#######################################
is_running() {
  [ -n "$(get_pid "$XRAY_BIN")" ]
}

ensure_cli_dirs() {
  ensure_dir "$LOG_DIR" "无法创建日志目录: $LOG_DIR"
  ensure_dir "$XRAY_DIR" "无法创建 Xray 配置目录: $XRAY_DIR"
}

read_xray_config() {
  local config

  config="$(read_conf "$MODULE_CONF" "XRAY_CONFIG" "$DEFAULT_XRAY_CONFIG")"
  [ -n "$config" ] || config="$DEFAULT_XRAY_CONFIG"
  printf "%s" "$config"
}

#######################################
# help
#######################################
show_service_help() {
  cat << EOF
用法:
  cli service status [--json]         查看服务状态
  cli service start                   启动服务
  cli service stop                    停止服务
  cli service restart                 重启服务
  cli service logs [service|xray] [行数]
                                      查看日志
EOF
}

show_xray_help() {
  cat << EOF
用法:
  cli xray config                     查看当前 Xray 配置路径
  cli xray show                       输出当前 Xray 配置内容
  cli xray test [文件]                使用 Xray 校验配置（默认当前配置）
  cli xray apply <文件>               校验通过后替换当前配置（旧配置备份为 .bak）
  cli xray version                    查看 Xray 版本
EOF
}

show_conf_help() {
  cat << EOF
用法:
  cli conf get <键>                   读取 module.conf 开关
  cli conf set <键> <0|1>             修改 module.conf 开关
可用键: $CONF_SWITCH_KEYS
EOF
}

show_geo_help() {
  cat << EOF
用法:
  cli geo status [--json]             查看 geoip / geosite 文件状态
  cli geo update [geoip|geosite|all]  在线更新 geo 数据（默认 all）
EOF
}

#######################################
# service 命令
#######################################
tproxy_active() {
  command iptables -w 100 -t mangle -nL PROXY_PREROUTING > /dev/null 2>&1
}

# 单行 JSON，供 WebUI 解析
cmd_service_status_json() {
  local pid running="false" uptime=0 version="" config tproxy="false"

  pid="$(get_pid "$XRAY_BIN")"
  if [ -n "$pid" ]; then
    running="true"
    uptime="$(get_process_uptime "$pid" || true)"
  fi
  if [ -x "$XRAY_BIN" ]; then
    version="$("$XRAY_BIN" version 2> /dev/null | head -1 || true)"
  fi
  tproxy_active && tproxy="true"
  config="$(read_xray_config)"

  printf '{"running":%s,"pid":"%s","uptime":%s,"version":"%s","config":"%s","tproxy":%s,"tproxy_port":"%s","auto_start":"%s","proxy_ipv6":"%s","proxy_hotspot":"%s","app_proxy_mode":"%s"}\n' \
    "$running" "$pid" "${uptime:-0}" "$(json_escape "$version")" "$(json_escape "$config")" "$tproxy" \
    "$(json_escape "$(read_conf "$MODULE_CONF" "TPROXY_PORT" "12345")")" \
    "$(read_conf "$MODULE_CONF" "AUTO_START" "1")" \
    "$(read_conf "$MODULE_CONF" "PROXY_IPV6" "1")" \
    "$(read_conf "$MODULE_CONF" "PROXY_HOTSPOT" "1")" \
    "$(json_escape "$(read_conf "$MODULE_CONF" "APP_PROXY_MODE" "off")")"
}

cmd_service_status() {
  local pid config version

  if [ "${1:-}" = "--json" ]; then
    cmd_service_status_json
    return
  fi

  section "服务状态"
  pid="$(get_pid "$XRAY_BIN")"

  if [ -n "$pid" ]; then
    printf "运行状态: %s运行中%s\n" "$GREEN" "$NC"
    printf "进程 PID: %s\n" "$pid"
    printf "运行时间: %s 秒\n" "$(get_process_uptime "$pid")"
  else
    printf "运行状态: %s未运行%s\n" "$RED" "$NC"
  fi

  config="$(read_xray_config)"
  printf "代理模式: TPROXY（端口 %s）\n" "$(read_conf "$MODULE_CONF" "TPROXY_PORT" "12345")"
  printf "Xray 配置: %s\n" "$config"

  if [ -x "$XRAY_BIN" ]; then
    version="$("$XRAY_BIN" version 2> /dev/null | head -1 || true)"
    [ -n "$version" ] && printf "内核版本: %s\n" "$version"
  fi
}

cmd_service_start() {
  ensure_cli_dirs
  info "正在启动服务..."
  sh "$SERVICE_SCRIPT" start
}

cmd_service_stop() {
  ensure_cli_dirs
  info "正在停止服务..."
  sh "$SERVICE_SCRIPT" stop
}

cmd_service_restart() {
  ensure_cli_dirs
  info "正在重启服务..."
  sh "$SERVICE_SCRIPT" restart
}

cmd_service_logs() {
  local target="${1:-service}"
  local lines="${2:-80}"
  local file

  case "$target" in
    service) file="$SERVICE_LOG" ;;
    core | xray) file="$XRAY_LOG" ;;
    *) die_cli "未知日志类型: $target" ;;
  esac

  [ -f "$file" ] || die_cli "日志文件不存在: $file"
  tail -n "$lines" "$file"
}

cmd_service() {
  local subcmd="${1:-status}"
  shift 2> /dev/null || true

  case "$subcmd" in
    status) cmd_service_status "$@" ;;
    start) cmd_service_start "$@" ;;
    stop) cmd_service_stop "$@" ;;
    restart) cmd_service_restart "$@" ;;
    logs) cmd_service_logs "$@" ;;
    help | -h | --help) show_service_help ;;
    *) die_cli "用法错误，使用 cli service help 查看帮助" ;;
  esac
}

#######################################
# xray 命令
#######################################
cmd_xray_config() {
  read_xray_config
  printf "\n"
}

cmd_xray_show() {
  local config

  config="$(read_xray_config)"
  [ -f "$config" ] || die_cli "Xray 配置文件不存在: $config"
  cat "$config"
}

cmd_xray_test() {
  local config="${1:-}"

  [ -n "$config" ] || config="$(read_xray_config)"
  [ -x "$XRAY_BIN" ] || die_cli "Xray 二进制不可执行: $XRAY_BIN"
  [ -f "$config" ] || die_cli "Xray 配置文件不存在: $config"

  export XRAY_LOCATION_ASSET="$XRAY_DIR"
  export XRAY_LOCATION_CONFIG="$XRAY_DIR"
  "$XRAY_BIN" run -test -config "$config"
}

# 校验候选配置 → 备份当前配置 → 原子替换
# 先把候选复制到临时文件，因此 apply 当前配置的 .bak 也能正确回滚
cmd_xray_apply() {
  local candidate="${1:-}"
  local config tmp

  [ -n "$candidate" ] || die_cli "用法: cli xray apply <候选配置文件>"
  [ -f "$candidate" ] || die_cli "候选配置文件不存在: $candidate"

  config="$(read_xray_config)"
  info "校验候选配置..."
  cmd_xray_test "$candidate" || die_cli "候选配置校验失败，当前配置未修改"

  tmp="$config.tmp.$$"
  cp -f "$candidate" "$tmp" || die_cli "无法写入临时文件: $tmp"
  if [ -f "$config" ] && ! cp -f "$config" "$config.bak"; then
    rm -f "$tmp"
    die_cli "无法备份当前配置: $config"
  fi
  chmod 0644 "$tmp"
  if ! mv -f "$tmp" "$config"; then
    rm -f "$tmp"
    die_cli "无法替换配置文件: $config"
  fi

  info "配置已保存: ${config}（上一版备份为 $config.bak）"
}

cmd_xray_version() {
  [ -x "$XRAY_BIN" ] || die_cli "Xray 二进制不可执行: $XRAY_BIN"
  "$XRAY_BIN" version
}

cmd_xray() {
  local subcmd="${1:-config}"
  shift 2> /dev/null || true

  case "$subcmd" in
    config | path) cmd_xray_config "$@" ;;
    show | cat) cmd_xray_show "$@" ;;
    test) cmd_xray_test "$@" ;;
    apply) cmd_xray_apply "$@" ;;
    version | -v | --version) cmd_xray_version "$@" ;;
    help | -h | --help) show_xray_help ;;
    *) die_cli "用法错误，使用 cli xray help 查看帮助" ;;
  esac
}

#######################################
# conf 命令：读写 module.conf 中的开关项
#######################################
require_switch_key() {
  list_contains "$CONF_SWITCH_KEYS" "$1" || die_cli "不支持的配置键: $1（可用: ${CONF_SWITCH_KEYS}）"
}

cmd_conf_get() {
  local key="${1:-}"

  [ -n "$key" ] || die_cli "用法: cli conf get <键>"
  require_switch_key "$key"
  read_conf "$MODULE_CONF" "$key" ""
  printf "\n"
}

cmd_conf_set() {
  local key="${1:-}"
  local value="${2:-}"

  [ -n "$key" ] || die_cli "用法: cli conf set <键> <0|1>"
  require_switch_key "$key"
  case "$value" in
    0 | 1) ;;
    *) die_cli "取值只能是 0 或 1: $value" ;;
  esac

  set_conf "$MODULE_CONF" "$key" "$value"
  info "$key=$value"
}

cmd_conf() {
  local subcmd="${1:-help}"
  shift 2> /dev/null || true

  case "$subcmd" in
    get) cmd_conf_get "$@" ;;
    set) cmd_conf_set "$@" ;;
    help | -h | --help) show_conf_help ;;
    *) die_cli "用法错误，使用 cli conf help 查看帮助" ;;
  esac
}

#######################################
# geo 命令：管理 geoip.dat / geosite.dat
#######################################
print_geo_file_status() {
  local label="$1"
  local file="$2"
  local size mtime

  if [ ! -f "$file" ]; then
    printf "%-10s : %s（缺失）\n" "$label" "$file"
    return
  fi

  size="$(wc -c < "$file" 2> /dev/null | tr -d ' ')"
  mtime="$(date -r "$file" '+%Y-%m-%d %H:%M:%S' 2> /dev/null || echo '未知')"
  printf "%-10s : %s\n" "$label" "$file"
  printf "%-10s   大小=%s 字节  修改时间=%s\n" "" "${size:-0}" "$mtime"
}

geo_file_json() {
  local file="$1"
  local size mtime

  if [ ! -f "$file" ]; then
    printf '{"exists":false}'
    return
  fi

  size="$(wc -c < "$file" 2> /dev/null | tr -d ' ')"
  mtime="$(date -r "$file" '+%Y-%m-%d %H:%M:%S' 2> /dev/null || true)"
  printf '{"exists":true,"size":%s,"mtime":"%s"}' "${size:-0}" "$(json_escape "$mtime")"
}

cmd_geo_status() {
  if [ "${1:-}" = "--json" ]; then
    printf '{"geoip":%s,"geosite":%s}\n' "$(geo_file_json "$GEOIP_FILE")" "$(geo_file_json "$GEOSITE_FILE")"
    return
  fi

  section "Geo 数据状态"
  print_geo_file_status "geoip"   "$GEOIP_FILE"
  print_geo_file_status "geosite" "$GEOSITE_FILE"
}

cmd_geo_update() {
  local target="${1:-all}"

  [ -f "$GEO_UPDATE_SCRIPT" ] || die_cli "geo-update 脚本不存在: $GEO_UPDATE_SCRIPT"

  info "正在更新 geo 数据 ($target)..."
  # geo_update.sh 自身只警告不退出非零；这里捕获退出码用于 CLI 友好提示
  if sh "$GEO_UPDATE_SCRIPT" "$target"; then
    info "geo 更新完成"
  else
    warn "geo 更新失败或部分失败，请查看 service.log"
    return 1
  fi
}

cmd_geo() {
  local subcmd="${1:-status}"
  shift 2> /dev/null || true

  case "$subcmd" in
    status) cmd_geo_status "$@" ;;
    update) cmd_geo_update "$@" ;;
    help | -h | --help) show_geo_help ;;
    *) die_cli "用法错误，使用 cli geo help 查看帮助" ;;
  esac
}

#######################################
# 总帮助
#######################################
show_help() {
  cat << EOF
NetProxy CLI (TPROXY 模式)

服务:
  cli service status [--json]         查看服务状态
  cli service start                   启动服务
  cli service stop                    停止服务
  cli service restart                 重启服务
  cli service logs [service|xray] [行数]
                                      查看日志

Xray:
  cli xray config                     查看当前配置路径
  cli xray show                       输出当前配置内容
  cli xray test [文件]                校验配置（默认当前配置）
  cli xray apply <文件>               校验后替换当前配置
  cli xray version                    查看 Xray 版本

Geo:
  cli geo status [--json]             查看 geoip / geosite 文件状态
  cli geo update [geoip|geosite|all]  在线更新 geo 数据（默认 all）

模块设置:
  cli conf get <键>                   读取开关（${CONF_SWITCH_KEYS}）
  cli conf set <键> <0|1>             修改开关
EOF
}

#######################################
# 主入口
#######################################
main() {
  local group="${1:-help}"
  shift 2> /dev/null || true

  ensure_cli_dirs

  case "$group" in
    service) cmd_service "$@" ;;
    xray | core) cmd_xray "$@" ;;
    geo) cmd_geo "$@" ;;
    conf) cmd_conf "$@" ;;
    help | -h | --help) show_help ;;
    *) die_cli "未知命令组: ${group}，使用 cli help 查看帮助" ;;
  esac
}

main "$@"
